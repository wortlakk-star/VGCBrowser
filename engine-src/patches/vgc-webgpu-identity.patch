 namespace {
 
+// ── VGC Core: WebGPU adapter identity ───────────────────────────────────────
+// WebGL's UNMASKED_VENDOR/RENDERER are answered natively from --vgc-webgl-vendor /
+// --vgc-webgl-renderer (WebGLRenderingContextBase::getParameter). Without this block,
+// navigator.gpu.requestAdapter().info still reported the REAL host GPU vendor and
+// architecture, which (a) contradicts the WebGL claim (a proof of spoofing) and (b) is
+// identical for every profile on one machine (a same-machine correlator). Derive the
+// WebGPU identity from the same claimed renderer string so both APIs describe one
+// coherent GPU. Spellings follow Dawn's gpu_info.json js_enum_case(): "ampere",
+// "lovelace", "blackwell", "rdna-2", "gcn-4", "gen-9", "gen-12lp", "xe-lpg"; Apple GPUs
+// are named by Metal family ("metal-3" on macOS 13+, "common-3" before — see
+// dawn/native/metal/PhysicalDeviceMTL.mm). Subgroup sizes follow what each backend
+// reports for the claimed vendor: D3D12 WaveLaneCount (NVIDIA 32/32, AMD RDNA 32/64,
+// GCN 64/64, Intel 8/32) and Metal (Apple 32/32, any other vendor 4/64).
+// Absent switches ⇒ stock behaviour.
+struct VgcGpuIdentity {
+  const char* vendor;
+  const char* architecture;
+  uint32_t subgroup_min;
+  uint32_t subgroup_max;
+};
+
+// The number right after `marker` in `s` ("rtx " → 3060 for "…rtx 3060 ti…"), 0 if none.
+unsigned VgcModelNumber(const std::string& s, const char* marker) {
+  size_t pos = s.find(marker);
+  if (pos == std::string::npos)
+    return 0;
+  pos += strlen(marker);
+  while (pos < s.size() && s[pos] == ' ')
+    ++pos;
+  unsigned n = 0;
+  bool any = false;
+  while (pos < s.size() && s[pos] >= '0' && s[pos] <= '9') {
+    n = n * 10 + static_cast<unsigned>(s[pos] - '0');
+    ++pos;
+    any = true;
+    if (n > 100000)
+      break;
+  }
+  return any ? n : 0;
+}
+
+bool VgcHas(const std::string& s, const char* needle) {
+  return s.find(needle) != std::string::npos;
+}
+
+// Lower-case and drop the "(r)" / "(tm)" marks real strings carry
+// ("Intel(R) Arc(TM) A770 Graphics" → "intel arc a770 graphics") so markers match.
+std::string VgcNormalize(std::string s) {
+  s = base::ToLowerASCII(s);
+  base::ReplaceSubstringsAfterOffset(&s, 0, "(r)", "");
+  base::ReplaceSubstringsAfterOffset(&s, 0, "(tm)", "");
+  base::ReplaceSubstringsAfterOffset(&s, 0, "  ", " ");
+  return s;
+}
+
+// Major version of --vgc-ua-platform-version ("14.5.0" → 14), 0 if absent.
+unsigned VgcClaimedOsMajor() {
+  const std::string v = base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+      "vgc-ua-platform-version");
+  unsigned major = 0;
+  const size_t dot = v.find('.');
+  base::StringToUint(dot == std::string::npos ? v : v.substr(0, dot), &major);
+  return major;
+}
+
+std::optional<VgcGpuIdentity> VgcWebGpuIdentity(bool metal_backend) {
+  const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+  const std::string renderer = VgcNormalize(cmd->GetSwitchValueASCII("vgc-webgl-renderer"));
+  const std::string vendor = VgcNormalize(cmd->GetSwitchValueASCII("vgc-webgl-vendor"));
+  if (renderer.empty() && vendor.empty())
+    return std::nullopt;
+  const std::string all = vendor + " " + renderer;
+  // Metal reports 4/64 for every non-Apple vendor (derivative group / uint64 ballot).
+  const uint32_t metal_min = 4, metal_max = 64;
+
+  if (VgcHas(all, "apple")) {
+    const unsigned os_major = VgcClaimedOsMajor();
+    return VgcGpuIdentity{"apple", os_major && os_major < 13 ? "common-3" : "metal-3", 32, 32};
+  }
+
+  if (VgcHas(all, "nvidia") || VgcHas(all, "geforce") || VgcHas(all, "quadro")) {
+    const unsigned rtx = VgcModelNumber(renderer, "rtx ");
+    const unsigned gtx = VgcModelNumber(renderer, "gtx ");
+    const unsigned mx = VgcModelNumber(renderer, "mx");
+    const char* arch = "ampere";
+    if (VgcHas(renderer, "blackwell"))
+      arch = "blackwell";
+    else if (VgcHas(renderer, " ada"))
+      arch = "lovelace";
+    else if (VgcHas(renderer, "quadro rtx") || VgcHas(renderer, " t600") ||
+             VgcHas(renderer, " t1000") || VgcHas(renderer, " t400"))
+      arch = "turing";
+    else if (rtx == 2050)
+      arch = "ampere";  // GA107 laptop part despite the 20xx name
+    else if (rtx >= 5000)
+      arch = "blackwell";
+    else if (rtx >= 4000)
+      arch = "lovelace";
+    else if (rtx >= 3000 || VgcHas(renderer, "rtx a"))
+      arch = "ampere";
+    else if (rtx >= 2000 || gtx >= 1600)
+      arch = "turing";
+    else if (gtx >= 1000)
+      arch = "pascal";
+    else if (gtx == 750 || gtx == 745 || gtx >= 900)
+      arch = "maxwell";
+    else if (gtx >= 600)
+      arch = "kepler";
+    else if (mx >= 570)
+      arch = "ampere";
+    else if (mx >= 450)
+      arch = "turing";
+    else if (mx >= 100)
+      arch = "pascal";
+    return VgcGpuIdentity{"nvidia", arch, metal_backend ? metal_min : 32u, metal_backend ? metal_max : 32u};
+  }
+
+  if (VgcHas(all, "amd") || VgcHas(all, "radeon")) {
+    const unsigned rx = VgcModelNumber(renderer, "rx ");
+    const char* arch = "rdna-2";
+    uint32_t smin = 32, smax = 64;
+    if (rx >= 9000)
+      arch = "rdna-4";
+    else if (rx >= 7000 || VgcHas(renderer, "780m") || VgcHas(renderer, "760m"))
+      arch = "rdna-3";
+    else if (rx >= 6000 || VgcHas(renderer, "680m") || VgcHas(renderer, "660m"))
+      arch = "rdna-2";
+    else if (rx >= 5000 || VgcHas(renderer, "pro 5"))
+      arch = "rdna-1";
+    else if (rx >= 400) {
+      arch = "gcn-4";  // RX 460…590 (Polaris)
+      smin = smax = 64;
+    } else if (VgcHas(renderer, "vega") || VgcHas(renderer, "radeon vii")) {
+      arch = "gcn-5";
+      smin = smax = 64;
+    }
+    if (metal_backend) { smin = metal_min; smax = metal_max; }
+    return VgcGpuIdentity{"amd", arch, smin, smax};
+  }
+
+  if (VgcHas(all, "intel")) {
+    const unsigned uhd = VgcModelNumber(renderer, "uhd graphics ");
+    const unsigned hd = VgcModelNumber(renderer, "hd graphics ");
+    const unsigned arc_a = VgcModelNumber(renderer, "arc a");
+    const unsigned arc_b = VgcModelNumber(renderer, "arc b");
+    const char* arch = "gen-12lp";
+    if (arc_b)
+      arch = "xe-2hpg";  // Arc B5xx (Battlemage)
+    else if (arc_a)
+      arch = "gen-12hp";  // Arc A3xx…A7xx (Alchemist)
+    else if (VgcHas(renderer, "arc 1"))
+      arch = "xe-2lpg";  // Arc 130V / 140V (Lunar Lake)
+    else if (VgcHas(renderer, "arc graphics"))
+      arch = "xe-lpg";  // Meteor Lake "Intel(R) Arc(TM) Graphics"
+    else if (VgcHas(renderer, "iris xe"))
+      arch = "gen-12lp";
+    else if (VgcHas(renderer, "iris plus"))
+      arch = "gen-11";
+    else if (uhd >= 700)
+      arch = "gen-12lp";  // UHD 710/730/750/770 (Alder/Raptor Lake)
+    else if (hd >= 5000 && hd < 6100)
+      arch = "gen-8";  // HD 5500 / 6000 (Broadwell)
+    else if (hd >= 4000 && hd < 5000)
+      arch = "gen-7";  // HD 4000 / 4400 / 4600 (Ivy/Haswell)
+    else if (uhd >= 600 || hd >= 500)
+      arch = "gen-9";  // UHD 610/620/630, HD 520/530/620/630
+    return VgcGpuIdentity{"intel", arch, metal_backend ? metal_min : 8u, metal_backend ? metal_max : 32u};
+  }
+
+  if (VgcHas(all, "adreno") || VgcHas(all, "qualcomm"))
+    return VgcGpuIdentity{"qualcomm", "adreno-8xx", 64, 64};
+
+  // Claimed GPU of an unknown family: report nothing rather than the real one.
+  return VgcGpuIdentity{"", "", metal_backend ? metal_min : 4u, metal_backend ? metal_max : 128u};
+}
