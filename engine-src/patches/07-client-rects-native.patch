+// VGC Core: per-profile client-rect farbling seeded from --vgc-seed (reuses the existing
+// switch, already forwarded to the renderer). Native so there is no JS Element.prototype
+// override to lie-detect, AND it farbles getClientRects + getBoundingClientRect
+// CONSISTENTLY — the old JS half-measure only touched getBoundingClientRect, so
+// getBoundingClientRect(el).width != getClientRects(el)[0].width was itself a tell. Same
+// (seed, rounded value) ⇒ same ±~1e-4 delta ⇒ stable across reads.
+uint32_t VgcRectSeed() {
+  static const uint32_t seed = [] {
+    const std::string s =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII("vgc-seed");
+    if (s.empty())
+      return 0u;
+    uint32_t h = 2166136261u;
+    for (char c : s) {
+      h ^= static_cast<uint8_t>(c);
+      h *= 16777619u;
+    }
+    return h == 0u ? 1u : h;
+  }();
+  return seed;
+}
+double VgcRectNoise(double v, uint32_t salt) {
+  const uint32_t seed = VgcRectSeed();
+  if (seed == 0)
+    return v;
+  // Seed the delta from the value rounded to the NEAREST PIXEL (not *1000): the raw layout
+  // value jitters at the sub-pixel level between separate getBoundingClientRect /
+  // getClientRects queries, and a fine quantization straddled the boundary → different
+  // delta → bcr != cr[0] (a tell). Integer-pixel quantization is stable across that jitter,
+  // so the same metric gets the same delta everywhere and the two APIs stay consistent.
+  const int64_t q = static_cast<int64_t>(v < 0 ? v - 0.5 : v + 0.5);
+  uint32_t s = seed ^ salt ^ static_cast<uint32_t>(q);
+  s ^= s >> 15; s *= 0x2C1B3C6Du; s ^= s >> 12; s *= 0x297A2D39u; s ^= s >> 15;
+  return v + ((static_cast<double>(s & 0xFFFFu) / 65535.0) - 0.5) * 0.0002;
+}
+gfx::RectF VgcNoiseRectF(const gfx::RectF& r) {
+  if (VgcRectSeed() == 0)
+    return r;
+  return gfx::RectF(VgcRectNoise(r.x(), 0x1001u), VgcRectNoise(r.y(), 0x2002u),
+                    VgcRectNoise(r.width(), 0x3003u), VgcRectNoise(r.height(), 0x4004u));
+}
+
+}  // namespace
