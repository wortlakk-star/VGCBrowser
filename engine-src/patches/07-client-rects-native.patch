+    rect = VgcNoiseRectF(rect);  // VGC: farble so getClientRects hashing differs per profile
   }
   return MakeGarbageCollected<DOMRectList>(rects);
 }
@@ -3505,7 +3553,31 @@ gfx::RectF Element::GetBoundingClientRectNoLifecycleUpdate() const {
 DOMRect* Element::GetBoundingClientRect() {
   GetDocument().EnsurePaintLocationDataValidForNode(
       this, DocumentUpdateReason::kJavaScript);
-  return DOMRect::FromRectF(GetBoundingClientRectNoLifecycleUpdate());
+  gfx::RectF bounds = GetBoundingClientRectNoLifecycleUpdate();
+  // VGC: build the bounding rect from the SAME per-rect farbling getClientRects() applies,
+  // then union — so union(getClientRects) == getBoundingClientRect exactly (a detector that
+  // cross-checks the two sees no discrepancy). Internal callers use the raw NoLifecycleUpdate
+  // path above, so layout/hit-testing are unaffected. Single-rect elements ⇒ bcr == cr[0].
+  if (VgcRectSeed() != 0) {
+    Vector<gfx::RectF> rects = GetClientRectsNoAdjustment();
+    LayoutObject* lo = GetLayoutObject();
+    if (!rects.empty() && lo) {
+      gfx::RectF u;
+      bool first = true;
+      for (auto& r : rects) {
+        GetDocument().AdjustRectForScrollAndAbsoluteZoom(r, *lo);
+        r = VgcNoiseRectF(r);
+        if (first) {
+          u = r;
+          first = false;
+        } else {
+          u.Union(r);
+        }
+      }
+      bounds = u;
+    }
+  }
+  return DOMRect::FromRectF(bounds);
 }
 
