 namespace {
 
+// VGC Core: per-profile FNV-1a seed from --vgc-seed. 0 => absent => no-op (stock).
+uint32_t VgcRectSeed() {
+  static const uint32_t seed = [] {
+    const std::string s =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII("vgc-seed");
+    if (s.empty())
+      return 0u;
+    uint32_t h = 2166136261u;
+    for (char c : s) {
+      h ^= static_cast<uint8_t>(c);
+      h *= 16777619u;
+    }
+    return h == 0u ? 1u : h;
+  }();
+  return seed;
+}
+
+// Deterministic sub-pixel offset for one metric (salt separates x/y/w/h).
+double VgcRectNoise(double v, uint32_t salt) {
+  const uint32_t seed = VgcRectSeed();
+  if (seed == 0)
+    return v;
+  uint32_t s = seed ^ salt ^ static_cast<uint32_t>(std::llround(v * 1000.0));
+  s ^= s >> 15;
+  s *= 0x2C1B3C6Du;
+  s ^= s >> 12;
+  s *= 0x297A2D39u;
+  s ^= s >> 15;
+  return v + ((static_cast<double>(s & 0xFFFFu) / 65535.0) - 0.5) * 0.0002;
+}
+
+gfx::RectF VgcNoiseRectF(const gfx::RectF& r) {
+  if (VgcRectSeed() == 0)
+    return r;
+  return gfx::RectF(VgcRectNoise(r.x(), 0x1001u), VgcRectNoise(r.y(), 0x2002u),
+                    VgcRectNoise(r.width(), 0x3003u), VgcRectNoise(r.height(), 0x4004u));
+}
