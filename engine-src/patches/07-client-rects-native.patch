# VGC Core — native client-rects farbling (getBoundingClientRect / getClientRects)
#
# STATUS: DRAFT — authored against Chromium M151 by METHOD NAME (see README: "match by
# method name, not line number"). NOT yet built/verified in CI like 01–05. Apply with:
#     patch -p1 --fuzz=3 < engine-src/patches/07-client-rects-native.patch
# then confirm the hunks landed in Element::getBoundingClientRect / Element::getClientRects
# and rebuild `chrome`. Reuses the EXISTING --vgc-seed switch (already passed by
# profile-manager.ts and already forwarded to the renderer by patch 02) — no new switch.
#
# WHY NATIVE: the JS version (src/main/stealth-extra.ts) overrides Element.prototype
# getters, which a lie-detector can flag via toString/descriptor probing. This C++ patch
# perturbs the rect at the source, so there is no JS tell. After this lands + verifies,
# set XCFG.clientRects to false for the native engine so the JS path stops double-noising.
#
# ALGORITHM: same shape as the JS farbling — a deterministic per-metric sub-pixel offset
# (~±1e-4 px) seeded from --vgc-seed. Same (seed, rounded-value) ⇒ same delta ⇒ stable
# across reads; different values ⇒ different deltas ⇒ ratios shift too.

--- a/third_party/blink/renderer/core/dom/element.cc
+++ b/third_party/blink/renderer/core/dom/element.cc
@@
 #include "base/auto_reset.h"
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
 #include "third_party/blink/renderer/core/geometry/dom_rect.h"
 #include "third_party/blink/renderer/core/geometry/dom_rect_list.h"
@@ namespace blink {

+namespace {
+
+// VGC Core: per-profile FNV-1a seed from --vgc-seed. 0 ⇒ absent ⇒ no-op (stock).
+uint32_t VgcRectSeed() {
+  static const uint32_t seed = [] {
+    const std::string s =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII("vgc-seed");
+    if (s.empty())
+      return 0u;
+    uint32_t h = 2166136261u;
+    for (char c : s) {
+      h ^= static_cast<uint8_t>(c);
+      h *= 16777619u;
+    }
+    return h == 0u ? 1u : h;
+  }();
+  return seed;
+}
+
+// Deterministic sub-pixel offset for one metric. salt separates x/y/w/h so a value
+// that appears as both (e.g. an element at x==width) still gets independent deltas.
+double VgcRectNoise(double v, uint32_t salt) {
+  const uint32_t seed = VgcRectSeed();
+  if (seed == 0)
+    return v;
+  uint32_t s = seed ^ salt ^ static_cast<uint32_t>(llround(v * 1000.0));
+  s ^= s >> 15; s *= 0x2C1B3C6Du; s ^= s >> 12; s *= 0x297A2D39u; s ^= s >> 15;
+  return v + ((static_cast<double>(s & 0xFFFFu) / 65535.0) - 0.5) * 0.0002;
+}
+
+gfx::RectF VgcNoiseRectF(const gfx::RectF& r) {
+  if (VgcRectSeed() == 0)
+    return r;
+  return gfx::RectF(VgcRectNoise(r.x(), 0x1001u), VgcRectNoise(r.y(), 0x2002u),
+                    VgcRectNoise(r.width(), 0x3003u), VgcRectNoise(r.height(), 0x4004u));
+}
+
+}  // namespace
+
@@ DOMRectList* Element::getClientRects() {
   Vector<gfx::QuadF> quads;
   element_layout_object->AbsoluteQuads(quads);
   AdjustForAbsoluteZoom::AdjustQuads(quads, *element_layout_object);
+  // VGC Core: farble each quad point so getClientRects hashing differs per profile.
+  if (VgcRectSeed() != 0) {
+    for (auto& q : quads) {
+      q.set_p1(gfx::PointF(VgcRectNoise(q.p1().x(), 0x11u), VgcRectNoise(q.p1().y(), 0x12u)));
+      q.set_p2(gfx::PointF(VgcRectNoise(q.p2().x(), 0x21u), VgcRectNoise(q.p2().y(), 0x22u)));
+      q.set_p3(gfx::PointF(VgcRectNoise(q.p3().x(), 0x31u), VgcRectNoise(q.p3().y(), 0x32u)));
+      q.set_p4(gfx::PointF(VgcRectNoise(q.p4().x(), 0x41u), VgcRectNoise(q.p4().y(), 0x42u)));
+    }
+  }
   return MakeGarbageCollected<DOMRectList>(quads);
 }
@@ DOMRect* Element::getBoundingClientRect() {
   GetDocument().EnsurePaintLocationDataValidForNode(
       this, DocumentUpdateReason::kJavaScript);
-  return DOMRect::FromRectF(GetBoundingClientRectNoLifecycleUpdate());
+  return DOMRect::FromRectF(VgcNoiseRectF(GetBoundingClientRectNoLifecycleUpdate()));
 }
