 KeychainPassword::~KeychainPassword() = default;
 
 std::string KeychainPassword::GetPassword() const {
+  // VGC Core: portable cross-machine os_crypt password. When --vgc-crypt-secret is
+  // provided, use it instead of the per-machine Keychain secret so cookies + saved
+  // passwords encrypted on one machine (including a Windows machine running the same
+  // secret) decrypt here, and vice-versa. The derivation downstream (PBKDF2-SHA1 +
+  // "saltysalt" → AES-128-CBC, tag "v10") is identical on every platform, so the
+  // ciphertext is cross-compatible. Falls back to the real Keychain when absent.
+  {
+    const std::string vgc_secret =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+            "vgc-crypt-secret");
+    if (!vgc_secret.empty()) {
+      return vgc_secret;
+    }
+  }
+
   auto password =
       GetPasswordImpl(*keychain_, GetServiceName(), GetAccountName());
 
