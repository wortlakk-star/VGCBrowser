+// VGC Core: is this font family exposable to the page? A page fingerprints the installed font
+// set by measuring text width per family (and via document.fonts.check()); on one machine every
+// profile enumerates the SAME real fonts — a same-machine correlator. We restrict the visible set
+// to the per-profile --vgc-fonts allowlist so each profile advertises its own list. Generics,
+// system fonts (empty / '.'-prefixed / system-ui) and emoji/symbol families ALWAYS pass so
+// rendering and generic fallbacks are unaffected. No switch => empty set => no filtering (stock).
+bool VgcFontAllowed(const AtomicString& family) {
+  static const std::unordered_set<std::string>* const allow = [] {
+    auto* s = new std::unordered_set<std::string>();
+    const std::string v =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII("vgc-fonts");
+    for (const auto& f : base::SplitString(v, ",", base::TRIM_WHITESPACE,
+                                           base::SPLIT_WANT_NONEMPTY)) {
+      s->insert(base::ToLowerASCII(f));
+    }
+    return s;
+  }();
+  if (allow->empty())
+    return true;  // no --vgc-fonts => do not filter
+  if (family.empty())
+    return true;
+  const std::string fam = base::ToLowerASCII(std::string(family.Utf8()));
+  if (fam.empty() || fam[0] == '.')
+    return true;  // system UI fonts (.AppleSystemUIFont, .SF NS, …) — never hide
+  static const char* const kGeneric[] = {
+      "serif",     "sans-serif",     "monospace",      "cursive",
+      "fantasy",   "system-ui",      "-apple-system",  "-webkit-body",
+      "-webkit-standard", "ui-serif", "ui-sans-serif", "ui-monospace",
+      "ui-rounded", "math",          "emoji",          "fangsong"};
+  for (const char* g : kGeneric) {
+    if (fam == g)
+      return true;
+  }
+  if (fam.find("emoji") != std::string::npos ||
+      fam.find("symbol") != std::string::npos)
+    return true;  // color-emoji / symbol fonts must always resolve
+  return allow->count(fam) > 0;
+}
+
+}  // namespace
