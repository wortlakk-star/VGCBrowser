+// VGC Core: per-profile canvas farbling seeded from --vgc-seed (mirrors the
+// getImageData path in base_rendering_context_2d.cc). Seed 0 ⇒ no-op.
+uint32_t VgcCanvasSeed() {
+  static const uint32_t seed = [] {
+    const std::string s =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII("vgc-seed");
+    if (s.empty())
+      return 0u;
+    uint32_t h = 2166136261u;
+    for (char c : s) {
+      h ^= static_cast<uint8_t>(c);
+      h *= 16777619u;
+    }
+    return h == 0u ? 1u : h;
+  }();
+  return seed;
+}
+
+inline uint8_t VgcNoiseBit(uint32_t seed, uint64_t index) {
+  uint32_t x = seed ^ (static_cast<uint32_t>(index) * 0x9E3779B9u);
+  x ^= x >> 16;
+  x *= 0x85EBCA6Bu;
+  x ^= x >> 13;
+  x *= 0xC2B2AE35u;
+  x ^= x >> 16;
+  return static_cast<uint8_t>(x & 1u);
+}
+
+// Fills `storage` with an LSB-farbled copy of `src` and points `out` at it.
+// Returns false (encode the original) when the seed is off or the format isn't
+// 8-bit RGBA/BGRA. Never mutates `src` — its pixels may be a shared snapshot.
+bool VgcFarbleCopy(const SkPixmap& src, Vector<uint8_t>& storage, SkPixmap* out) {
+  const uint32_t seed = VgcCanvasSeed();
+  if (seed == 0)
+    return false;
+  const SkColorType ct = src.colorType();
+  if (ct != kRGBA_8888_SkColorType && ct != kBGRA_8888_SkColorType)
+    return false;
+  base::span<const uint8_t> src_bytes = gfx::SkPixmapToSpan(src);
+  if (src_bytes.empty() ||
+      src_bytes.size() > std::numeric_limits<wtf_size_t>::max())
+    return false;
+  storage.resize(static_cast<wtf_size_t>(src_bytes.size()));
+  base::span<uint8_t> dst = base::span(storage);
+  dst.copy_from(src_bytes);
+  const size_t w = static_cast<size_t>(src.width());
+  const size_t h = static_cast<size_t>(src.height());
+  const size_t row_bytes = src.rowBytes();
+  uint64_t idx = 1;
+  for (size_t y = 0; y < h; ++y) {
+    base::span<uint8_t> row = dst.subspan(y * row_bytes, w * 4);
+    for (size_t x = 0; x < w; ++x) {
+      base::span<uint8_t> px = row.subspan(x * 4, static_cast<size_t>(4));
+      px[0] ^= VgcNoiseBit(seed, idx++);
+      px[1] ^= VgcNoiseBit(seed, idx++);
+      px[2] ^= VgcNoiseBit(seed, idx++);
+    }
+  }
+  *out = SkPixmap(src.info(), storage.data(), row_bytes);
+  return true;
