+// VGC: per-profile font allowlist. --vgc-fonts is a comma-separated list of the family
+// names this profile is allowed to expose. Every OTHER installed family resolves to
+// nullptr (→ CSS fallback), so the width probe (offsetWidth of a styled span),
+// canvas measureText, and FontFaceSet.check all agree that a non-allowlisted font is
+// "not installed". Without this, every profile on one machine enumerates the IDENTICAL
+// real Windows font set — a high-entropy same-machine correlator Google/creepjs use to
+// link "different" browsers. The allowlist is a SUBSET of the machine's real fonts
+// (the app never invents fonts), so everything reported still renders for real; the
+// per-profile variation lives in which OPTIONAL fonts are exposed, exactly mirroring how
+// real machines differ by their installed software.
+bool VgcFontAllowed(const AtomicString& family) {
+  // std types (not WTF::String) so the parsed set can be read from font-matching on
+  // worker threads (OffscreenCanvas) without WTF string refcount races.
+  static const base::NoDestructor<std::optional<std::unordered_set<std::string>>> allow(
+      [] {
+        std::optional<std::unordered_set<std::string>> set;
+        std::string raw =
+            base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII("vgc-fonts");
+        if (!raw.empty()) {
+          std::unordered_set<std::string> s;
+          for (const auto& piece : base::SplitString(
+                   raw, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+            s.insert(base::ToLowerASCII(piece));
+          }
+          set = std::move(s);
+        }
+        return set;
+      }());
+  if (!allow->has_value()) {
+    return true;  // switch absent → do not restrict anything
+  }
+  if (family.empty()) {
+    return true;
+  }
+  const std::string lower = base::ToLowerASCII(String(family).Utf8());
+  // Generic keywords + a minimal set of always-present Windows fonts, so page/UI
+  // rendering and the default fallback chain never break regardless of the allowlist.
+  static const char* const kAlways[] = {
+      "serif", "sans-serif", "monospace", "cursive", "fantasy", "system-ui",
+      "ui-serif", "ui-sans-serif", "ui-monospace", "ui-rounded", "math",
+      "-webkit-standard", "-webkit-body", "segoe ui", "arial", "times new roman",
+      "courier new", "tahoma", "verdana", "ms shell dlg", "ms shell dlg 2"};
+  for (const char* g : kAlways) {
+    if (lower == g) {
+      return true;
+    }
+  }
+  return (*allow)->count(lower) > 0;
+}
