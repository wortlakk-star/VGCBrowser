@@ -181,10 +181,30 @@ const blink::UserAgentBrandList GetUserAgentBrandList(
 // `version` value.
 // TODO(crbug.com/1291612): Consolidate *MajorVersionList() methods by using
 // GetVersionNumber()
+// VGC: the Chrome version the UA-CH brand list should report. The app spoofs the
+// UA STRING per profile (e.g. "Chrome/149.0.0.0") but the engine is built at a
+// different version (151) — if UA-CH kept reporting the engine's 151 while the UA
+// string says 149, that mismatch is an instant anti-bot tell (Cloudflare loops).
+// So we take the version from --vgc-ua-full-version (fed by the profile's
+// fingerprint.uaFullVersion, e.g. "149.0.7827.54") and fall back to the engine's
+// real version only when the switch is absent.
+std::string VgcSpoofedFullVersion() {
+  std::string v = base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+      "vgc-ua-full-version");
+  if (!v.empty()) {
+    return v;
+  }
+  return std::string(version_info::GetVersionNumber());
+}
+std::string VgcSpoofedMajorVersion() {
+  std::string full = VgcSpoofedFullVersion();
+  size_t dot = full.find('.');
+  return dot == std::string::npos ? full : full.substr(0, dot);
+}
+
 const blink::UserAgentBrandList GetUserAgentBrandMajorVersionListInternal(
     std::optional<blink::UserAgentBrandVersion> additional_brand_version) {
-  return GetUserAgentBrandList(version_info::GetMajorVersionNumber(),
-                               std::string(version_info::GetVersionNumber()),
+  return GetUserAgentBrandList(VgcSpoofedMajorVersion(), VgcSpoofedFullVersion(),
                                blink::UserAgentBrandVersionType::kMajorVersion,
                                additional_brand_version);
 }
