+// VGC Core: the OS TTS voice list ("Microsoft David/Zira/Mark") is identical across every profile
+// on one machine → a same-machine correlator. Expose a per-profile SUBSET (deterministic per
+// --vgc-seed): always keep voice 0 (an empty list is itself a tell) + ~75% of the rest. Native =
+// no JS getter tell (the old stealth-extra getVoices Proxy made its toString anonymous).
+static uint32_t VgcVoiceSeed() {
+  static const uint32_t seed = [] {
+    const std::string s =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII("vgc-seed");
+    if (s.empty())
+      return 0u;
+    uint32_t h = 2166136261u;
+    for (char c : s) {
+      h ^= static_cast<uint8_t>(c);
+      h *= 16777619u;
+    }
+    return h == 0u ? 1u : h;
+  }();
+  return seed;
+}
+static bool VgcKeepVoice(uint32_t seed, uint32_t i) {
+  if (i == 0)
+    return true;  // always keep the primary voice
+  uint32_t s = seed ^ 0x5F356495u ^ (i + 1u) * 0x9E3779B1u;
+  s ^= s >> 15;
+  s *= 0x2C1B3C6Du;
+  s ^= s >> 13;
+  return (s & 3u) != 0u;  // keep ~75% of the rest
+}
+
 void SpeechSynthesis::OnSetVoiceList(
     Vector<mojom::blink::SpeechSynthesisVoicePtr> mojom_voices) {
   voice_list_.clear();
+  const uint32_t vgc_seed = VgcVoiceSeed();
+  uint32_t idx = 0;
   for (auto& mojom_voice : mojom_voices) {
-    voice_list_.push_back(
-        MakeGarbageCollected<SpeechSynthesisVoice>(std::move(mojom_voice)));
+    if (vgc_seed == 0 || VgcKeepVoice(vgc_seed, idx)) {
+      voice_list_.push_back(
+          MakeGarbageCollected<SpeechSynthesisVoice>(std::move(mojom_voice)));
+    }
+    ++idx;
   }
   VoicesDidChange();
 }
