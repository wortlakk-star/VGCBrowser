# VGC Core — native screen spoof (screen.width/height/avail*/colorDepth/pixelDepth)
#
# STATUS: DRAFT — authored against Chromium M151 by METHOD NAME (see README: "match by
# method name, not line number"). NOT yet built/verified in CI like 01–05. Apply with:
#     patch -p1 --fuzz=3 < engine-src/patches/06-screen-native.patch
# then confirm each Screen::* accessor got the guard and rebuild `chrome`.
#
# NEW SWITCH: --vgc-screen=WIDTHxHEIGHT  (+ optional --vgc-color-depth=24)
#   • Add to src/main/profile-manager.ts (native switches block, alongside --vgc-seed):
#         `--vgc-screen=${fp.screen.width}x${fp.screen.height}`,
#         `--vgc-color-depth=${fp.screen.colorDepth}`,
#   • --vgc-* switches are already forwarded to the renderer by patch 02, and Screen lives
#     in the renderer (Blink), so no extra forwarding is needed.
#
# WHY NATIVE: screen is currently spoofed in JS (webrtc-guard.ts screenScript +
# stealth-extra.ts availLeft/availTop). JS getters on Screen.prototype are the single most
# lie-detectable surface left. Overriding at the C++ accessor removes the tell entirely.
#
# ⚠️ AFTER THIS LANDS + VERIFIES: delete screenScript() from webrtc-guard.ts and the screen
#   block + availLeft/availTop from the JS injectors, so native and JS do not double-spoof
#   (double-spoofing re-introduces a JS tell on top of the now-native value). Keep the JS
#   screen spoof ONLY on the system-Chrome / CDP fallback path, which has no native engine.
#
# NOTE: availHeight is width/height minus a taskbar inset (kVgcTaskbarInset), mirroring the
#   JS "height - 40". availLeft/availTop = 0 (primary monitor). Adjust the inset per target OS
#   if you later run non-Windows profiles.

--- a/third_party/blink/renderer/core/frame/screen.cc
+++ b/third_party/blink/renderer/core/frame/screen.cc
@@
 #include "third_party/blink/renderer/core/frame/screen.h"

+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
 #include "third_party/blink/renderer/core/frame/local_dom_window.h"
 #include "third_party/blink/renderer/core/frame/local_frame.h"
@@ namespace blink {

+namespace {
+
+// VGC Core: parse --vgc-screen=WIDTHxHEIGHT and --vgc-color-depth once. Absent ⇒ no-op.
+struct VgcScreenCfg {
+  int width = 0;
+  int height = 0;
+  int depth = 0;
+  bool has_size = false;
+  bool has_depth = false;
+};
+const VgcScreenCfg& VgcScreen() {
+  static const VgcScreenCfg cfg = [] {
+    VgcScreenCfg v;
+    const auto* cmd = base::CommandLine::ForCurrentProcess();
+    const std::string size = cmd->GetSwitchValueASCII("vgc-screen");
+    if (!size.empty()) {
+      const auto parts = base::SplitString(size, "x", base::TRIM_WHITESPACE,
+                                           base::SPLIT_WANT_NONEMPTY);
+      int w = 0, h = 0;
+      if (parts.size() == 2 && base::StringToInt(parts[0], &w) &&
+          base::StringToInt(parts[1], &h) && w > 0 && h > 0) {
+        v.width = w;
+        v.height = h;
+        v.has_size = true;
+      }
+    }
+    const std::string depth = cmd->GetSwitchValueASCII("vgc-color-depth");
+    int d = 0;
+    if (!depth.empty() && base::StringToInt(depth, &d) && d > 0) {
+      v.depth = d;
+      v.has_depth = true;
+    }
+    return v;
+  }();
+  return cfg;
+}
+// Taskbar/menubar inset removed from the reported avail height (mirrors JS "height - 40").
+constexpr int kVgcTaskbarInset = 40;
+
+}  // namespace
+
@@ int Screen::height() const {
+  if (VgcScreen().has_size)
+    return VgcScreen().height;
   if (!DomWindow())
     return 0;
@@ int Screen::width() const {
+  if (VgcScreen().has_size)
+    return VgcScreen().width;
   if (!DomWindow())
     return 0;
@@ unsigned Screen::colorDepth() const {
+  if (VgcScreen().has_depth)
+    return static_cast<unsigned>(VgcScreen().depth);
   if (!DomWindow())
     return 0;
@@ unsigned Screen::pixelDepth() const {
+  if (VgcScreen().has_depth)
+    return static_cast<unsigned>(VgcScreen().depth);
   if (!DomWindow())
     return 0;
@@ int Screen::availLeft() const {
+  if (VgcScreen().has_size)
+    return 0;
   if (!DomWindow())
     return 0;
@@ int Screen::availTop() const {
+  if (VgcScreen().has_size)
+    return 0;
   if (!DomWindow())
     return 0;
@@ int Screen::availHeight() const {
+  if (VgcScreen().has_size)
+    return VgcScreen().height - kVgcTaskbarInset;
   if (!DomWindow())
     return 0;
@@ int Screen::availWidth() const {
+  if (VgcScreen().has_size)
+    return VgcScreen().width;
   if (!DomWindow())
     return 0;
