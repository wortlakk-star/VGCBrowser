 namespace blink {
 
+namespace {
+
+// VGC Core: parse --vgc-screen=WIDTHxHEIGHT and --vgc-color-depth once. Absent => no-op.
+struct VgcScreenCfg {
+  int width = 0;
+  int height = 0;
+  int depth = 0;
+  bool has_size = false;
+  bool has_depth = false;
+};
+const VgcScreenCfg& VgcScreen() {
+  static const VgcScreenCfg cfg = [] {
+    VgcScreenCfg v;
+    const auto* cmd = base::CommandLine::ForCurrentProcess();
+    const std::string size = cmd->GetSwitchValueASCII("vgc-screen");
+    if (!size.empty()) {
+      const auto parts = base::SplitString(size, "x", base::TRIM_WHITESPACE,
+                                           base::SPLIT_WANT_NONEMPTY);
+      int w = 0, h = 0;
+      if (parts.size() == 2 && base::StringToInt(parts[0], &w) &&
+          base::StringToInt(parts[1], &h) && w > 0 && h > 0) {
+        v.width = w;
+        v.height = h;
+        v.has_size = true;
+      }
+    }
+    const std::string depth = cmd->GetSwitchValueASCII("vgc-color-depth");
+    int d = 0;
+    if (!depth.empty() && base::StringToInt(depth, &d) && d > 0) {
+      v.depth = d;
+      v.has_depth = true;
+    }
+    return v;
+  }();
+  return cfg;
+}
+// Menubar/taskbar inset removed from the reported avail height (mirrors JS "height - 40").
+constexpr int kVgcTaskbarInset = 40;
+
+}  // namespace
