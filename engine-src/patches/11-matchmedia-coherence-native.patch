 namespace blink {
 
+namespace {
+// VGC Core: parse --vgc-screen=WxH once. The device-width/height media features must match
+// the spoofed screen (screen.cc) so `@media (device-width: <spoofed>px)` and
+// `matchMedia('(max-device-width: …)')` stay coherent. Without this the app needed a JS
+// matchMedia Proxy shim, which broke Cloudflare Turnstile (anonymous-name integrity check);
+// doing it natively fixes the coherence AND removes the wrapper.
+bool VgcScreenWH(int* w, int* h) {
+  static const std::pair<int, int> kWH = [] {
+    const std::string v =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII("vgc-screen");
+    auto parts = base::SplitString(v, "x", base::TRIM_WHITESPACE,
+                                   base::SPLIT_WANT_NONEMPTY);
+    int pw = 0, ph = 0;
+    if (parts.size() == 2 && base::StringToInt(parts[0], &pw) &&
+        base::StringToInt(parts[1], &ph) && pw > 0 && ph > 0) {
+      return std::make_pair(pw, ph);
+    }
+    return std::make_pair(0, 0);
+  }();
+  *w = kWH.first;
+  *h = kWH.second;
+  return kWH.first > 0 && kWH.second > 0;
+}
+}  // namespace
