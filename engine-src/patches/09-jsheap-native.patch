 namespace blink {
 
+// VGC Core: V8's jsHeapSizeLimit scales with PHYSICAL RAM, not navigator.deviceMemory (8GB+ →
+// 4,395,630,592; 4GB → 2,172,649,472). A profile spoofing deviceMemory:4 on a big rig otherwise
+// leaks a 4.4GB heap limit — an internal contradiction creepjs/pixelscan flag. Cap the limit to
+// the canonical value for the spoofed --vgc-device-memory (only ever DOWN). Native = no JS getter
+// tell (the old JS override made jsHeapSizeLimit's getter toString anonymous). 0 = not set.
+static uint64_t VgcHeapLimit() {
+  static const uint64_t limit = [] {
+    const std::string s =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+            "vgc-device-memory");
+    double dm = 0;
+    if (s.empty() || !base::StringToDouble(s, &dm) || dm <= 0)
+      return uint64_t{0};
+    if (dm <= 2)
+      return uint64_t{1090519040};   // ~1.02 GB
+    if (dm <= 4)
+      return uint64_t{2172649472};   // ~2.02 GB
+    return uint64_t{4395630592};     // ~4.09 GB (8GB+)
+  }();
+  return limit;
+}
+
 static constexpr base::TimeDelta kTwentyMinutes = base::Minutes(20);
 static constexpr base::TimeDelta kFiftyMs = base::Milliseconds(50);
 
@@ -52,6 +76,10 @@ static void GetHeapSize(HeapInfo& info) {
   info.total_js_heap_size =
       heap_statistics.total_physical_size() + heap_statistics.external_memory();
   info.js_heap_size_limit = heap_statistics.heap_size_limit();
+  // VGC Core: cap the heap limit to match the spoofed deviceMemory (see VgcHeapLimit).
+  uint64_t vgc_limit = VgcHeapLimit();
+  if (vgc_limit && vgc_limit < info.js_heap_size_limit)
+    info.js_heap_size_limit = vgc_limit;
 }
 
