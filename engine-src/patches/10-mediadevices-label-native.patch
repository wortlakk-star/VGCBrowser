 String MediaDeviceInfo::label() const {
+  // VGC Core: blank the device label (mic/cam model string, e.g. "HD Pro Webcam C920",
+  // "Realtek Audio") — it is IDENTICAL across every profile on a host, a same-machine
+  // correlator (deviceId/groupId are already per-profile salted by the separate user-data-dir).
+  // toJSONForBinding() calls label(), so this also covers JSON.stringify(device). Real Chrome
+  // returns "" before getUserMedia permission anyway; blanking always keeps two profiles from
+  // ever sharing the hardware model string. Native so there is no JS prototype override to
+  // lie-detect (the JS one left an anonymous-name toString tell on label + toJSON).
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch("vgc-seed"))
+    return String("");
   return label_;
 }
 
