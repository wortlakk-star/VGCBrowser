 namespace blink {
 
+// VGC Core: the mic/cam LABEL ("HD Pro Webcam C920", "Realtek Audio") is identical across every
+// profile on one machine → the real cross-machine correlator. Blank it natively (deviceId/groupId
+// are per-profile salted by Chrome already, so getUserMedia({deviceId:{exact}}) selection still
+// works). Native accessor = no JS getter tell (the old stealth-extra JS override made
+// label.toString() anonymous). Gated on --vgc-seed so genuine Chrome is untouched. label() is
+// called by toJSONForBinding, so JSON.stringify(device) is covered too.
+static bool VgcBlankMediaLabels() {
+  static const bool blank =
+      base::CommandLine::ForCurrentProcess()->HasSwitch("vgc-seed");
+  return blank;
+}
+
 MediaDeviceInfo::MediaDeviceInfo(const String& device_id,
                                  const String& label,
                                  const String& group_id,
@@ -62,6 +75,8 @@ V8MediaDeviceKind MediaDeviceInfo::kind() const {
 }
 
 String MediaDeviceInfo::label() const {
+  if (VgcBlankMediaLabels())
+    return g_empty_string;
   return label_;
 }
 
