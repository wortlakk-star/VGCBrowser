{
  "manifest_version": 3,
  "name": "HI",
  "description": "Password-locked encrypted cookie and tab transfer for Chrome/Edge profiles.",
  "version": "1.3.3",
  "action": {
    "default_title": "HI",
    "default_popup": "popup.html"
  },
  "permissions": [
    "tabs",
    "cookies",
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
